# Database (TiDB Cloud Serverless — create at tidbcloud.com)
DATABASE_URL=mysql://<user>:<pass>@<host>:4000/<dbname>?ssl={"rejectUnauthorized":true}

# Session signing key — generate with: openssl rand -base64 32
JWT_SECRET=

# Google OAuth — create at console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of this app (used as OAuth redirect base)
VITE_CANONICAL_ORIGIN=https://carpool.wavenova.org

# Luma events integration
LUMA_API_KEY=

# App branding
VITE_APP_TITLE=WaveNova Carpool Board
VITE_APP_LOGO=

# Admin / owner
ADMIN_EMAIL=hi@wavenova.org
OWNER_NAME=Andrew Lien
OWNER_OPEN_ID=

# Google Maps JavaScript API key (optional — needed for map display)
VITE_GOOGLE_MAPS_API_KEY=

# S3-compatible storage for event cover image uploads (optional)
# Works with AWS S3 or Cloudflare R2 (set endpoint for R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=
